// Prisma schema for the Lead Intelligence Platform.
//
// TENANCY RULES (ADR 0008) — every table except `tenants` is tenant-owned:
//   * `tenant_id uuid NOT NULL` referencing tenants(id)
//   * PostgreSQL row-level security ENABLED + FORCED with the `tenant_isolation`
//     policy (added by hand in the migration SQL; Prisma does not model RLS)
//   * unique constraints and foreign keys are composite with tenant_id, so a row
//     can never reference another tenant's row
// The schema-guard integration test fails CI if a table breaks these rules.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenant registry (platform-level; the only table without tenant_id)
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Immutable, [a-z][a-z0-9]{1,39}; used in secret keys (tenant.<slug>.…)
  slug      String   @unique
  name      String
  /// active | suspended | offboarded
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  integrations         TenantIntegration[]
  flowSettings         TenantFlowSetting[]
  credentialRefs       TenantCredentialRef[]
  oauthTokens          TenantOAuthToken[]
  oauthStates          TenantOAuthState[]
  webhookReceipts      TenantWebhookReceipt[]
  qualificationConfig  TenantQualificationConfig?
  products             TenantProduct[]
  leadSourceMappings   TenantLeadSourceMapping[]
  policies             TenantPolicy[]
  companies            Company[]
  persons              Person[]
  contextChanges       TenantContextChange[]
  sourceRelationships  TenantSourceRelationship[]
  identityConflicts    TenantIdentityConflict[]
  deadLetters          TenantDeadLetter[]
  syncCheckpoints      TenantSyncCheckpoint[]
  productModels        TenantProductModel[]
  subscriptions        TenantSubscription[]
  eligibilitySnapshots TenantEligibilitySnapshot[]
  sourceConnections    TenantSourceConnection[]
  authorityVersions    TenantSourceAuthorityVersion[]
  auditEvents          TenantAuditEvent[]
  auditAnchors         TenantAuditAnchor[]
  canonicalAdoptions   TenantCanonicalAdoption[]
  moduleSettings       TenantModuleSetting[]
  registryVersions     TenantRegistryVersion[]
  entityIndex          TenantEntityIndex[]
  valueHistory         TenantValueHistory[]
  integrityRuns        TenantIntegrityRun[]
  sourceReferences     TenantSourceReference[]
  evidenceLinks        TenantEvidenceLink[]
  personAffiliations   TenantPersonAffiliation[]
  extensionValues      TenantExtensionValue[]
  extensionValueItems  TenantExtensionValueItem[]
  customRecords        TenantCustomRecord[]
  customRelationships  TenantCustomRelationship[]
  accountContexts      TenantAccountContext[]
  contextPersons       TenantAccountContextPerson[]
  contextProducts      TenantAccountContextProduct[]
  capabilityGrants     TenantCapabilityGrant[]
  customObjectOwners   TenantCustomObjectOwner[]

  @@unique([id, slug])
  @@map("tenants")
}

/// Connector-kind catalogue (ADR 0019): platform reference data mirrored from
/// `domain/connector-kinds.ts`, seeded by migration, read-only to the app role.
/// Every source-system column references it; there is no tenant_id.
model ConnectorKind {
  kind        String  @id
  displayName String  @map("display_name")
  /// A source adapter module ships for this kind in this release
  hasAdapter  Boolean @map("has_adapter")

  companyExternalRefs CompanyExternalRef[]
  personExternalRefs  PersonExternalRef[]
  contextChanges      TenantContextChange[]
  sourceRelationships TenantSourceRelationship[]
  deadLetters         TenantDeadLetter[]
  syncCheckpoints     TenantSyncCheckpoint[]
  subscriptions       TenantSubscription[]
  sourceConnections   TenantSourceConnection[]
  sourceReferences    TenantSourceReference[]

  @@map("connector_kinds")
}

// ---------------------------------------------------------------------------
// Tenant configuration
// ---------------------------------------------------------------------------

model TenantIntegration {
  tenantId  String   @map("tenant_id") @db.Uuid
  /// hubspot | sugar | gainsight_cs | gainsight_px | jev
  system    String
  /// disabled | read_only | read_write
  access    String   @default("disabled")
  settings  Json     @default("{}")
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, system])
  @@map("tenant_integrations")
}

model TenantFlowSetting {
  tenantId  String   @map("tenant_id") @db.Uuid
  /// e.g. hubspot_to_sugar_handover
  flow      String
  /// off | shadow | coexist | active (allowed values depend on the flow)
  mode      String   @default("off")
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, flow])
  @@map("tenant_flow_settings")
}

/// A pointer to a secret held by the SecretProvider. Never the secret itself.
model TenantCredentialRef {
  tenantId   String   @map("tenant_id") @db.Uuid
  /// Denormalised so a CHECK constraint can force secret_key to start with tenant.<slug>.
  tenantSlug String   @map("tenant_slug")
  system     String
  name       String
  secretKey  String   @map("secret_key")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant            Tenant                   @relation(fields: [tenantId, tenantSlug], references: [id, slug], onDelete: Restrict, onUpdate: Restrict)
  sourceConnections TenantSourceConnection[]

  @@id([tenantId, system, name])
  @@map("tenant_credential_refs")
}

/// An OAuth grant a tenant gave the platform by installing its app (ADR 0010).
/// Token columns hold AES-256-GCM ciphertext ("v2:<kid>:…", or "v1:…" before M10A1; bound to tenant, system
/// and column), never a token: a CHECK constraint rejects anything else.
model TenantOAuthToken {
  tenantId             String    @map("tenant_id") @db.Uuid
  /// hubspot (later: other OAuth-based systems)
  system               String
  /// The external account the grant belongs to (HubSpot: portal id).
  accountId            String    @map("account_id")
  refreshTokenEnc      String    @map("refresh_token_enc")
  /// Shared short-lived access token, so one refresh serves every process.
  accessTokenEnc       String?   @map("access_token_enc")
  accessTokenExpiresAt DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  scopes               String[]  @default([])
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, system])
  @@map("tenant_oauth_tokens")
}

/// A pending OAuth install: redeemed exactly once, by an atomic DELETE (ADR 0010).
/// Stores only a hash of the state's nonce.
model TenantOAuthState {
  tenantId  String   @map("tenant_id") @db.Uuid
  nonceHash String   @map("nonce_hash")
  system    String
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, nonceHash])
  @@map("tenant_oauth_states")
}

/// One webhook event received for a tenant (ADR 0011): metadata only. Property
/// values and request bodies are never stored (CHECK constraints keep every
/// column to identifiers). Redeliveries of the same event update the counters
/// of the one row; the key is a SHA-256 of the event's identity.
model TenantWebhookReceipt {
  tenantId           String   @map("tenant_id") @db.Uuid
  system             String
  deliveryKey        String   @map("delivery_key")
  eventId            String   @map("event_id")
  subscriptionId     String   @map("subscription_id")
  /// The external account the event came from (HubSpot: portal id).
  accountId          String   @map("account_id")
  appId              String   @map("app_id")
  /// e.g. object.creation, object.propertyChange
  subscriptionType   String   @map("subscription_type")
  /// HubSpot object type id, e.g. 0-1 (contact), 0-2 (company), 0-136 (lead)
  objectTypeId       String?  @map("object_type_id")
  objectId           String?  @map("object_id")
  /// Name of the changed property (never its value)
  propertyName       String?  @map("property_name")
  changeSource       String?  @map("change_source")
  occurredAt         DateTime @map("occurred_at") @db.Timestamptz(3)
  firstAttemptNumber Int      @map("first_attempt_number")
  lastAttemptNumber  Int      @map("last_attempt_number")
  /// How many times the event was delivered (1 = no redelivery)
  deliveries         Int      @default(1)
  receivedAt         DateTime @default(now()) @map("received_at") @db.Timestamptz(3)
  lastReceivedAt     DateTime @default(now()) @map("last_received_at") @db.Timestamptz(3)

  // Merge events (identifiers only)
  primaryObjectId      String?  @map("primary_object_id")
  newObjectId          String?  @map("new_object_id")
  mergedObjectIds      String[] @default([]) @map("merged_object_ids")
  // Association-change events (identifiers only)
  fromObjectId         String?  @map("from_object_id")
  fromObjectTypeId     String?  @map("from_object_type_id")
  toObjectId           String?  @map("to_object_id")
  toObjectTypeId       String?  @map("to_object_type_id")
  associationTypeId    Int?     @map("association_type_id")
  associationCategory  String?  @map("association_category")
  associationRemoved   Boolean? @map("association_removed")
  isPrimaryAssociation Boolean? @map("is_primary_association")

  /// M6 processing state (ADR 0013): pending | processing | retrying | processed |
  /// ineligible | deferred | irrelevant | source_not_found | dead_lettered
  processingStatus   String    @default("pending") @map("processing_status")
  /// Reason code for a terminal or deferred status (never free text)
  processingReason   String?   @map("processing_reason")
  processingAttempts Int       @default(0) @map("processing_attempts")
  processedAt        DateTime? @map("processed_at") @db.Timestamptz(3)
  /// End-to-end trace id, set at intake
  correlationId      String?   @map("correlation_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, system, deliveryKey])
  @@index([tenantId, receivedAt])
  @@index([tenantId, processingStatus, receivedAt])
  @@map("tenant_webhook_receipts")
}

model TenantQualificationConfig {
  tenantId       String   @id @map("tenant_id") @db.Uuid
  /// rules | jev | hybrid
  mode           String   @default("rules")
  rulesetVersion String?  @map("ruleset_version")
  settings       Json     @default("{}")
  version        Int      @default(1)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("tenant_qualification_config")
}

/// Read-only projection of the latest published product model (ADR 0016).
/// Written only by publishing; rows are never deleted (K4).
model TenantProduct {
  tenantId     String   @map("tenant_id") @db.Uuid
  key          String
  name         String
  description  String?
  active       Boolean  @default(true)
  family       String?
  /// Last published model version that defined this product
  modelVersion Int?     @map("model_version")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant          Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subscriptions   TenantSubscription[]
  snapshots       TenantEligibilitySnapshot[]
  contextProducts TenantAccountContextProduct[]

  @@id([tenantId, key])
  @@map("tenant_products")
}

/// Immutable product model versions (ADR 0016): catalogue, relationships,
/// conditions. Never updated or deleted (trigger).
model TenantProductModel {
  tenantId      String   @map("tenant_id") @db.Uuid
  version       Int
  document      Json
  contentHash   String   @map("content_hash")
  effectiveFrom DateTime @map("effective_from") @db.Timestamptz(3)
  publishedAt   DateTime @default(now()) @map("published_at") @db.Timestamptz(3)
  publishedBy   String   @map("published_by")

  tenant             Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  snapshots          TenantEligibilitySnapshot[]
  declaredReferences TenantSourceReference[]     @relation("SourceReferenceDeclaredIn")
  retiredReferences  TenantSourceReference[]     @relation("SourceReferenceRetiredByModel")

  @@id([tenantId, version])
  @@index([tenantId, effectiveFrom])
  @@map("tenant_product_models")
}

/// One source subscription line (ADR 0017). Ownership is derived, never stored.
model TenantSubscription {
  tenantId         String    @map("tenant_id") @db.Uuid
  id               String    @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  productKey       String    @map("product_key")
  /// active | trial | expired | cancelled | unknown
  state            String
  startsAt         DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt           DateTime? @map("ends_at") @db.Timestamptz(3)
  quantity         Int?
  sourceSystem     String    @map("source_system")
  sourceObjectType String    @map("source_object_type")
  sourceRecordId   String    @map("source_record_id")
  /// active | deleted (source tombstone)
  recordState      String    @default("active") @map("record_state")
  sourceUpdatedAt  DateTime? @map("source_updated_at") @db.Timestamptz(3)
  observedAt       DateTime  @map("observed_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)
  /// SHA-256 of the source-provided values only (never the resolved company)
  fieldHash        String?   @map("field_hash")
  firstSeenAt      DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  lastChangeId     String?   @map("last_change_id") @db.Uuid
  /// M10E: the line's account context (0..1; same account, guard trigger; NULL = none)
  contextId        String?   @map("context_id") @db.Uuid

  tenant  Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  company Company               @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  product TenantProduct         @relation(fields: [tenantId, productKey], references: [tenantId, key], onDelete: Restrict, onUpdate: Restrict)
  source  ConnectorKind         @relation(fields: [sourceSystem], references: [kind], onDelete: Restrict, onUpdate: Restrict)
  context TenantAccountContext? @relation(fields: [tenantId, contextId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, id])
  @@unique([tenantId, sourceSystem, sourceObjectType, sourceRecordId])
  @@index([tenantId, companyId])
  @@index([tenantId, productKey])
  @@index([tenantId, contextId])
  @@map("tenant_subscriptions")
}

model TenantLeadSourceMapping {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  system         String
  /// e.g. recent_conversion
  sourceProperty String   @map("source_property")
  /// equals | contains
  matchType      String   @map("match_type")
  sourceValue    String   @map("source_value")
  channel        String
  label          String?
  priority       Int      @default(100)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, system, sourceProperty, matchType, sourceValue])
  @@map("tenant_lead_source_mappings")
}

model TenantPolicy {
  tenantId  String   @map("tenant_id") @db.Uuid
  /// sla | routing | requalification
  kind      String
  document  Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, kind])
  @@map("tenant_policies")
}

// ---------------------------------------------------------------------------
// Identity: canonical people and organisations
// ---------------------------------------------------------------------------

model Company {
  id                  String   @id @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  /// Nullable (ADR 0014): a source record may have no usable name; never a placeholder
  name                String?
  domains             String[] @default([])
  customerStatus      String   @default("unknown") @map("customer_status")
  /// active | inactive (no active source reference) | merged (see merged_into_id)
  recordState         String   @default("active") @map("record_state")
  mergedIntoId        String?  @map("merged_into_id") @db.Uuid
  createdAt           DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @map("updated_at") @db.Timestamptz(3)
  /// M10C: canonical `parent_account_id` (same-tenant composite FK; acyclic, enforced by the
  /// companies_hierarchy_guard trigger; NULL = no parent)
  parentCompanyId     String?  @map("parent_company_id") @db.Uuid
  /// M10C: source_provided | human — who last set or cleared the parent (NULL = never set)
  parentCompanyOrigin String?  @map("parent_company_origin")

  tenant             Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  mergedInto         Company?                    @relation("CompanyMergedInto", fields: [tenantId, mergedIntoId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  mergedFrom         Company[]                   @relation("CompanyMergedInto")
  parent             Company?                    @relation("CompanyParent", fields: [tenantId, parentCompanyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  children           Company[]                   @relation("CompanyParent")
  affiliations       TenantPersonAffiliation[]
  subscriptions      TenantSubscription[]
  snapshotsRequested TenantEligibilitySnapshot[] @relation("SnapshotRequestedCompany")
  snapshotsEvaluated TenantEligibilitySnapshot[] @relation("SnapshotEvaluatedCompany")
  externalRefs       CompanyExternalRef[]
  persons            Person[]
  ownershipGaps      TenantOwnershipGap[]
  accountContexts    TenantAccountContext[]

  @@unique([tenantId, id])
  @@index([tenantId, name])
  @@index([tenantId, parentCompanyId], map: "companies_tenant_parent_idx")
  @@map("companies")
}

model CompanyExternalRef {
  tenantId             String    @map("tenant_id") @db.Uuid
  system               String
  objectType           String    @map("object_type")
  externalId           String    @map("external_id")
  companyId            String    @map("company_id") @db.Uuid
  /// active | deleted | merged (ADR 0014) | retired (M9B: absent from an accepted full read)
  state                String    @default("active")
  mergedIntoExternalId String?   @map("merged_into_external_id")
  firstSeenAt          DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt           DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  sourceCreatedAt      DateTime? @map("source_created_at") @db.Timestamptz(3)
  sourceUpdatedAt      DateTime? @map("source_updated_at") @db.Timestamptz(3)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(3)
  /// SHA-256 of the last applied mapped fields (idempotency; no values)
  fieldHash            String?   @map("field_hash")
  lastChangeId         String?   @map("last_change_id") @db.Uuid
  /// M9B: set exactly when `state = retired` (the accepted full run that no longer returned it)
  retiredAt            DateTime? @map("retired_at") @db.Timestamptz(3)
  retiredByRunId       String?   @map("retired_by_run_id") @db.Uuid

  company      Company               @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)
  connector    ConnectorKind         @relation(fields: [system], references: [kind], onDelete: Restrict, onUpdate: Restrict)
  retiredByRun TenantSyncCheckpoint? @relation(fields: [tenantId, retiredByRunId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, system, objectType, externalId])
  @@index([tenantId, companyId])
  @@map("company_external_refs")
}

model Person {
  id               String   @id @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  /// Nullable and not unique (ADR 0014): email is not identity
  primaryEmail     String?  @map("primary_email")
  additionalEmails String[] @default([]) @map("additional_emails")
  firstName        String?  @map("first_name")
  lastName         String?  @map("last_name")
  jobTitle         String?  @map("job_title")
  companyId        String?  @map("company_id") @db.Uuid
  roles            String[] @default([])
  /// active | inactive | merged (ADR 0014)
  recordState      String   @default("active") @map("record_state")
  mergedIntoId     String?  @map("merged_into_id") @db.Uuid
  createdAt        DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  company        Company?                     @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  mergedInto     Person?                      @relation("PersonMergedInto", fields: [tenantId, mergedIntoId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  mergedFrom     Person[]                     @relation("PersonMergedInto")
  externalRefs   PersonExternalRef[]
  affiliations   TenantPersonAffiliation[]
  contextMembers TenantAccountContextPerson[]

  @@unique([tenantId, id])
  @@index([tenantId, primaryEmail])
  @@index([tenantId, companyId])
  @@map("persons")
}

model PersonExternalRef {
  tenantId             String    @map("tenant_id") @db.Uuid
  system               String
  objectType           String    @map("object_type")
  externalId           String    @map("external_id")
  personId             String    @map("person_id") @db.Uuid
  state                String    @default("active")
  mergedIntoExternalId String?   @map("merged_into_external_id")
  firstSeenAt          DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt           DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  sourceCreatedAt      DateTime? @map("source_created_at") @db.Timestamptz(3)
  sourceUpdatedAt      DateTime? @map("source_updated_at") @db.Timestamptz(3)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(3)
  fieldHash            String?   @map("field_hash")
  lastChangeId         String?   @map("last_change_id") @db.Uuid

  person    Person        @relation(fields: [tenantId, personId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)
  connector ConnectorKind @relation(fields: [system], references: [kind], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, system, objectType, externalId])
  @@index([tenantId, personId])
  @@map("person_external_refs")
}

// ---------------------------------------------------------------------------
// Canonical context processing (Milestone 6, ADR 0013 / 0014)
// ---------------------------------------------------------------------------

/// Provenance: one append-only row per real canonical change. Field NAMES only;
/// values live in the canonical record.
model TenantContextChange {
  tenantId           String    @map("tenant_id") @db.Uuid
  id                 String    @db.Uuid
  /// company | person | subscription | product (M10B)
  entityKind         String    @map("entity_kind")
  /// exactly one of entity_id / entity_key (M10B: products are key-identified)
  entityId           String?   @map("entity_id") @db.Uuid
  /// M10B: the product key when entity_kind = 'product'
  entityKey          String?   @map("entity_key")
  /// created | updated | state_changed | merged | ref_added | relationship_changed
  changeType         String    @map("change_type")
  changedFields      String[]  @default([]) @map("changed_fields")
  sourceSystem       String    @map("source_system")
  sourceObjectType   String    @map("source_object_type")
  sourceRecordId     String    @map("source_record_id")
  /// webhook | backfill | reconciliation | replay | resync
  cause              String
  receiptDeliveryKey String?   @map("receipt_delivery_key")
  checkpointId       String?   @map("checkpoint_id") @db.Uuid
  sourceUpdatedAt    DateTime? @map("source_updated_at") @db.Timestamptz(3)
  ingestedAt         DateTime  @default(now()) @map("ingested_at") @db.Timestamptz(3)
  adapter            String
  adapterVersion     String    @map("adapter_version")
  correlationId      String    @map("correlation_id") @db.Uuid
  /// M8: the tenant source connection that produced the change (NULL before M8)
  sourceConnectionId String?   @map("source_connection_id") @db.Uuid
  /// M8: the mapping version that produced the change (versioned connections only)
  mappingVersion     Int?      @map("mapping_version")
  /// M10A1: who wrote the change (NULL = written before M10A1)
  actorKind          String?   @map("actor_kind")
  actorId            String?   @map("actor_id")
  /// system | asserted | authenticated
  actorAssurance     String?   @map("actor_assurance")
  /// M10A2: source_provided | deterministic | ai_derived | human | migration (NULL before M10A2)
  origin             String?
  /// M10A2: {key, version, inputs_hash}, required iff origin is derived
  derivation         Json?
  /// M10A2: the canonical version the write conformed to
  canonicalVersion   String?   @map("canonical_version")
  /// M10A2: the schema snapshot of the mapping version (versioned connections)
  schemaSnapshotHash String?   @map("schema_snapshot_hash")
  /// M10A2: applied transforms as field:transform_id (names only)
  transforms         String[]

  tenant              Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  canonical           CanonicalModelVersion?       @relation(fields: [canonicalVersion], references: [version], onDelete: Restrict, onUpdate: Restrict)
  valueHistory        TenantValueHistory[]
  sourceReferences    TenantSourceReference[]      @relation("SourceReferenceLastChange")
  evidenceCitations   TenantEvidenceLink[]         @relation("EvidenceLinkEvidenceChange")
  evidenceLinkSets    TenantEvidenceLink[]         @relation("EvidenceLinkChange")
  personAffiliations  TenantPersonAffiliation[]
  extensionValues     TenantExtensionValue[]
  customRecords       TenantCustomRecord[]
  customRelationships TenantCustomRelationship[]
  accountContexts     TenantAccountContext[]
  contextPersons      TenantAccountContextPerson[]
  source              ConnectorKind                @relation(fields: [sourceSystem], references: [kind], onDelete: Restrict, onUpdate: Restrict)
  connection          TenantSourceConnection?      @relation(fields: [tenantId, sourceConnectionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  mapping             TenantSourceMappingVersion?  @relation(fields: [tenantId, sourceConnectionId, mappingVersion], references: [tenantId, connectionId, version], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, id])
  @@index([tenantId, entityKind, entityId, ingestedAt])
  @@index([tenantId, entityKind, entityKey, ingestedAt])
  @@index([tenantId, ingestedAt])
  @@map("tenant_context_changes")
}

/// Source relationships (e.g. HubSpot contact↔company associations) as context only.
model TenantSourceRelationship {
  tenantId          String    @map("tenant_id") @db.Uuid
  system            String
  fromObjectType    String    @map("from_object_type")
  fromExternalId    String    @map("from_external_id")
  toObjectType      String    @map("to_object_type")
  toExternalId      String    @map("to_external_id")
  associationTypeId Int       @map("association_type_id")
  category          String
  isPrimary         Boolean   @default(false) @map("is_primary")
  /// active | removed
  state             String    @default("active")
  sourceObservedAt  DateTime? @map("source_observed_at") @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  connector ConnectorKind @relation(fields: [system], references: [kind], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, system, fromObjectType, fromExternalId, toObjectType, toExternalId, associationTypeId])
  @@index([tenantId, system, toObjectType, toExternalId])
  @@map("tenant_source_relationships")
}

/// Identity questions recorded for later review; never resolved automatically in M6.
model TenantIdentityConflict {
  tenantId     String    @map("tenant_id") @db.Uuid
  id           String    @db.Uuid
  /// shared_email | merge_across_systems | ambiguous_primary_company
  kind         String
  /// company | person
  entityKind   String    @map("entity_kind")
  /// SHA-256 of the conflict's identity (kind + sorted refs/ids): one row per conflict
  conflictKey  String    @map("conflict_key")
  canonicalIds String[]  @default([]) @map("canonical_ids")
  /// system:objectType:externalId keys (identifiers only)
  externalRefs String[]  @default([]) @map("external_refs")
  /// open | resolved
  state        String    @default("open")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, id])
  @@unique([tenantId, conflictKey])
  @@map("tenant_identity_conflicts")
}

/// Jobs that will not be retried (ADR 0013). Identifiers and codes only.
model TenantDeadLetter {
  tenantId           String    @map("tenant_id") @db.Uuid
  id                 String    @db.Uuid
  queue              String
  jobName            String    @map("job_name")
  jobId              String    @map("job_id")
  subjectSystem      String?   @map("subject_system")
  subjectKind        String?   @map("subject_kind")
  subjectExternalId  String?   @map("subject_external_id")
  receiptDeliveryKey String?   @map("receipt_delivery_key")
  checkpointId       String?   @map("checkpoint_id") @db.Uuid
  correlationId      String    @map("correlation_id") @db.Uuid
  errorCode          String    @map("error_code")
  httpStatus         Int?      @map("http_status")
  attempts           Int
  firstFailedAt      DateTime  @default(now()) @map("first_failed_at") @db.Timestamptz(3)
  lastFailedAt       DateTime  @default(now()) @map("last_failed_at") @db.Timestamptz(3)
  /// open | replayed | discarded
  state              String    @default("open")
  resolvedAt         DateTime? @map("resolved_at") @db.Timestamptz(3)
  /// operator reason code (replay | discarded_<code>)
  resolution         String?

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subjectSource ConnectorKind? @relation(fields: [subjectSystem], references: [kind], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, id])
  @@unique([tenantId, jobId])
  @@index([tenantId, state, lastFailedAt])
  @@map("tenant_dead_letters")
}

/// Progress of a backfill or reconciliation run; the cursor lives here, not in Redis.
model TenantSyncCheckpoint {
  tenantId           String    @map("tenant_id") @db.Uuid
  id                 String    @db.Uuid
  system             String
  /// company | person | subscription
  kind               String
  /// backfill | reconcile | import_full | import_incremental
  mode               String
  /// running | completed | failed | cancelled
  status             String    @default("running")
  /// system:kind:mode while running, NULL afterwards: one active run per kind and mode
  activeKey          String?   @map("active_key")
  /// Opaque source paging cursor for the next page
  cursor             String?
  /// Reconcile: inclusive lower bound of the current search window (source time)
  windowSince        DateTime? @map("window_since") @db.Timestamptz(3)
  /// Highest source modification time fully processed
  highWatermark      DateTime? @map("high_watermark") @db.Timestamptz(3)
  pageNo             Int       @default(0) @map("page_no")
  recordsSeen        Int       @default(0) @map("records_seen")
  recordsChanged     Int       @default(0) @map("records_changed")
  recordsSkipped     Int       @default(0) @map("records_skipped")
  recordsFailed      Int       @default(0) @map("records_failed")
  maxRecords         Int?      @map("max_records")
  pageSize           Int       @default(100) @map("page_size")
  correlationId      String    @map("correlation_id") @db.Uuid
  startedAt          DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(3)
  lastErrorCode      String?   @map("last_error_code")
  /// Import runs: SHA-256 of the input file
  inputHash          String?   @map("input_hash")
  /// M8: the tenant source connection the run read (NULL for pre-M8 non-import runs)
  sourceConnectionId String?   @map("source_connection_id") @db.Uuid
  /// M8: the mapping version the run applied (versioned connections only)
  mappingVersion     Int?      @map("mapping_version")
  /// M8: run quality counters and codes (counts and codes only, never values); M9A adds `proof`
  quality            Json?

  tenant                  Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  connector               ConnectorKind               @relation(fields: [system], references: [kind], onDelete: Restrict, onUpdate: Restrict)
  connection              TenantSourceConnection?     @relation(fields: [tenantId, sourceConnectionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  mapping                 TenantSourceMappingVersion? @relation(fields: [tenantId, sourceConnectionId, mappingVersion], references: [tenantId, connectionId, version], onDelete: Restrict, onUpdate: Restrict)
  profiles                TenantSourceProfile[]
  retiredRefs             CompanyExternalRef[]
  retiredSourceReferences TenantSourceReference[]

  @@id([tenantId, id])
  @@unique([tenantId, activeKey])
  @@index([tenantId, system, kind, mode, status, completedAt])
  @@map("tenant_sync_checkpoints")
}

/// Frozen eligibility evidence (ADR 0018): written only when a consumer relies
/// on a result. Append-only (trigger); reproduces exactly from its inputs.
model TenantEligibilitySnapshot {
  tenantId           String   @map("tenant_id") @db.Uuid
  id                 String   @db.Uuid
  /// The company asked about (may have been merged away since)
  requestedCompanyId String   @map("requested_company_id") @db.Uuid
  /// The canonical company actually evaluated (merge lineage resolved)
  evaluatedCompanyId String   @map("evaluated_company_id") @db.Uuid
  productKey         String   @map("product_key")
  asOf               DateTime @map("as_of") @db.Timestamptz(3)
  evaluatedAt        DateTime @default(now()) @map("evaluated_at") @db.Timestamptz(3)
  /// eligible | ineligible | unknown
  status             String
  /// owned | not_owned | unknown
  ownership          String
  modelVersion       Int      @map("model_version")
  modelHash          String   @map("model_hash")
  evaluatorVersion   Int      @map("evaluator_version")
  factsHash          String   @map("facts_hash")
  /// Checks plus the frozen input facts (identifiers, codes, dates)
  result             Json
  purpose            String
  correlationId      String   @map("correlation_id") @db.Uuid

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requestedCompany Company            @relation("SnapshotRequestedCompany", fields: [tenantId, requestedCompanyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  evaluatedCompany Company            @relation("SnapshotEvaluatedCompany", fields: [tenantId, evaluatedCompanyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  product          TenantProduct      @relation(fields: [tenantId, productKey], references: [tenantId, key], onDelete: Restrict, onUpdate: Restrict)
  model            TenantProductModel @relation(fields: [tenantId, modelVersion], references: [tenantId, version], onDelete: Restrict, onUpdate: Restrict)

  evidenceCitations TenantEvidenceLink[]

  @@id([tenantId, id])
  @@index([tenantId, evaluatedCompanyId, productKey, evaluatedAt])
  @@index([tenantId, requestedCompanyId])
  @@map("tenant_eligibility_snapshots")
}

// ---------------------------------------------------------------------------
// Source connectors (Milestone 8, ADR 0019 / 0020)
// ---------------------------------------------------------------------------

/// One configured source per tenant and connector kind (M8). Non-secret
/// configuration only; credentials are names resolved through SecretProvider.
model TenantSourceConnection {
  tenantId       String    @map("tenant_id") @db.Uuid
  id             String    @db.Uuid
  kind           String
  label          String
  /// enabled | disabled
  status         String    @default("disabled")
  /// versioned (mapping versions) | code (adapter code: hubspot, import)
  mappingMode    String    @map("mapping_mode")
  /// Adapter-validated non-secret configuration (a CHECK refuses secret-like keys)
  config         Json      @default("{}")
  /// Logical credential name in tenant_credential_refs (kind, name); never a value
  credentialName String?   @map("credential_name")
  /// Outcome code of the last testConnection (no payload)
  lastTestCode   String?   @map("last_test_code")
  lastTestedAt   DateTime? @map("last_tested_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  tenant                     Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  connector                  ConnectorKind                  @relation(fields: [kind], references: [kind], onDelete: Restrict, onUpdate: Restrict)
  credential                 TenantCredentialRef?           @relation(fields: [tenantId, kind, credentialName], references: [tenantId, system, name], onDelete: Restrict, onUpdate: Restrict)
  contextChanges             TenantContextChange[]
  syncCheckpoints            TenantSyncCheckpoint[]
  schemaSnapshots            TenantSourceSchemaSnapshot[]
  mappingVersions            TenantSourceMappingVersion[]
  ownershipGaps              TenantOwnershipGap[]
  profileRuns                TenantSourceProfileRun[]
  profiles                   TenantSourceProfile[]
  profilePurges              TenantSourceProfilePurge[]
  mappingDrafts              TenantSourceMappingDraft[]
  sourceReferences           TenantSourceReference[]
  authorityAccountProfile    TenantSourceAuthorityVersion[] @relation("AuthorityAccountProfile")
  authorityPersonProfile     TenantSourceAuthorityVersion[] @relation("AuthorityPersonProfile")
  authoritySubscriptionLines TenantSourceAuthorityVersion[] @relation("AuthoritySubscriptionLines")
  authoritySubscriptionState TenantSourceAuthorityVersion[] @relation("AuthoritySubscriptionState")
  authoritySubscriptionTerms TenantSourceAuthorityVersion[] @relation("AuthoritySubscriptionTerms")
  authorityAccountHierarchy  TenantSourceAuthorityVersion[] @relation("AuthorityAccountHierarchy")
  authorityAccountContext    TenantSourceAuthorityVersion[] @relation("AuthorityAccountContext")
  extensionValues            TenantExtensionValue[]
  customRelationships        TenantCustomRelationship[]
  customObjectOwners         TenantCustomObjectOwner[]

  @@id([tenantId, id])
  @@unique([tenantId, kind])
  @@map("tenant_source_connections")
}

/// Normalised, metadata-only schema of a connection (ADR 0019 §5). Immutable.
model TenantSourceSchemaSnapshot {
  tenantId      String   @map("tenant_id") @db.Uuid
  connectionId  String   @map("connection_id") @db.Uuid
  /// SHA-256 of the normalised document
  hash          String
  sourceVersion String?  @map("source_version")
  document      Json
  capturedAt    DateTime @default(now()) @map("captured_at") @db.Timestamptz(3)
  capturedBy    String   @map("captured_by")

  connection      TenantSourceConnection       @relation(fields: [tenantId, connectionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  mappingVersions TenantSourceMappingVersion[]
  profileRuns     TenantSourceProfileRun[]
  profiles        TenantSourceProfile[]

  @@id([tenantId, connectionId, hash])
  @@index([tenantId, connectionId, capturedAt])
  @@map("tenant_source_schema_snapshots")
}

/// One immutable mapping publication per connection (ADR 0020 §1).
model TenantSourceMappingVersion {
  tenantId            String   @map("tenant_id") @db.Uuid
  connectionId        String   @map("connection_id") @db.Uuid
  version             Int
  baseVersion         Int      @map("base_version")
  document            Json
  contentHash         String   @map("content_hash")
  schemaSnapshotHash  String   @map("schema_snapshot_hash")
  /// The authority version the document was validated against
  authorityVersion    Int      @map("authority_version")
  /// Warning codes and counts at publish (never values)
  validation          Json     @default("{}")
  publishedBy         String   @map("published_by")
  publishedAt         DateTime @default(now()) @map("published_at") @db.Timestamptz(3)
  /// M10A2: the canonical version validated against (NULL before M10A2 = 0.1)
  canonicalVersionMin String?  @map("canonical_version_min")

  canonicalMin       CanonicalModelVersion?         @relation(fields: [canonicalVersionMin], references: [version], onDelete: Restrict, onUpdate: Restrict)
  lifecycle          TenantSourceMappingLifecycle[]
  connection         TenantSourceConnection         @relation(fields: [tenantId, connectionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  snapshot           TenantSourceSchemaSnapshot     @relation(fields: [tenantId, connectionId, schemaSnapshotHash], references: [tenantId, connectionId, hash], onDelete: Restrict, onUpdate: Restrict)
  authority          TenantSourceAuthorityVersion   @relation(fields: [tenantId, authorityVersion], references: [tenantId, version], onDelete: Restrict, onUpdate: Restrict)
  contextChanges     TenantContextChange[]
  syncCheckpoints    TenantSyncCheckpoint[]
  /// M10D hardening #83: the custom objects this version holds as owner (Q14).
  customObjectOwners TenantCustomObjectOwner[]

  @@id([tenantId, connectionId, version])
  @@map("tenant_source_mapping_versions")
}

/// Which connection may write each business fact (ADR 0020 §8). Immutable versions.
model TenantSourceAuthorityVersion {
  tenantId                      String   @map("tenant_id") @db.Uuid
  version                       Int
  baseVersion                   Int      @map("base_version")
  accountProfileConnectionId    String?  @map("account_profile_connection_id") @db.Uuid
  personProfileConnectionId     String?  @map("person_profile_connection_id") @db.Uuid
  subscriptionLinesConnectionId String?  @map("subscription_lines_connection_id") @db.Uuid
  subscriptionStateConnectionId String?  @map("subscription_state_connection_id") @db.Uuid
  subscriptionTermsConnectionId String?  @map("subscription_terms_connection_id") @db.Uuid
  /// M10C: the connection that may write the account hierarchy (NULL = nobody)
  accountHierarchyConnectionId  String?  @map("account_hierarchy_connection_id") @db.Uuid
  /// M10E: the connection that may write account contexts (NULL = nobody)
  accountContextConnectionId    String?  @map("account_context_connection_id") @db.Uuid
  contentHash                   String   @map("content_hash")
  /// M9A: operator acceptances of adapter-declared stable_snapshot proofs (ADR 0023)
  proofAcceptances              Json     @default("[]") @map("proof_acceptances")
  publishedBy                   String   @map("published_by")
  publishedAt                   DateTime @default(now()) @map("published_at") @db.Timestamptz(3)

  tenant            Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  accountProfile    TenantSourceConnection?      @relation("AuthorityAccountProfile", fields: [tenantId, accountProfileConnectionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  personProfile     TenantSourceConnection?      @relation("AuthorityPersonProfile", fields: [tenantId, personProfileConnectionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  subscriptionLines TenantSourceConnection?      @relation("AuthoritySubscriptionLines", fields: [tenantId, subscriptionLinesConnectionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  subscriptionState TenantSourceConnection?      @relation("AuthoritySubscriptionState", fields: [tenantId, subscriptionStateConnectionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  subscriptionTerms TenantSourceConnection?      @relation("AuthoritySubscriptionTerms", fields: [tenantId, subscriptionTermsConnectionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  accountHierarchy  TenantSourceConnection?      @relation("AuthorityAccountHierarchy", fields: [tenantId, accountHierarchyConnectionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  accountContext    TenantSourceConnection?      @relation("AuthorityAccountContext", fields: [tenantId, accountContextConnectionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  mappingVersions   TenantSourceMappingVersion[]

  @@id([tenantId, version])
  @@map("tenant_source_authority_versions")
}

/// Accounts holding a line whose product cannot be known (ADR 0020 §15):
/// derived state, replaced per completed full run of the connection.
model TenantOwnershipGap {
  tenantId         String   @map("tenant_id") @db.Uuid
  connectionId     String   @map("connection_id") @db.Uuid
  sourceObjectType String   @map("source_object_type")
  sourceRecordId   String   @map("source_record_id")
  companyId        String   @map("company_id") @db.Uuid
  /// missing_product_reference | orphan_product_reference | observation_rejected |
  /// holding_filter_value_unreviewed | account_reference_orphaned (M9A)
  reason           String
  checkpointId     String   @map("checkpoint_id") @db.Uuid
  recordedAt       DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)

  connection TenantSourceConnection @relation(fields: [tenantId, connectionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  company    Company                @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, connectionId, sourceObjectType, sourceRecordId])
  @@index([tenantId, companyId])
  @@map("tenant_ownership_gaps")
}

/// M9A (ADR 0022): a source profiling run. Mutable until terminal (forward-only
/// lifecycle trigger); one active run per connection (active_key).
model TenantSourceProfileRun {
  tenantId           String    @map("tenant_id") @db.Uuid
  id                 String    @db.Uuid
  connectionId       String    @map("connection_id") @db.Uuid
  schemaSnapshotHash String    @map("schema_snapshot_hash")
  /// requested | running | completed | failed | abandoned
  status             String    @default("requested")
  activeKey          String?   @map("active_key")
  /// objects, selected field names, opt-ins, sampling method, maxRows (names only)
  request            Json
  sampling           Json?
  errorCode          String?   @map("error_code")
  requestedBy        String    @map("requested_by")
  correlationId      String    @map("correlation_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt          DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt         DateTime? @map("finished_at") @db.Timestamptz(3)

  connection TenantSourceConnection     @relation(fields: [tenantId, connectionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "tenant_source_profile_runs_tenant_id_connection_id_fkey")
  snapshot   TenantSourceSchemaSnapshot @relation(fields: [tenantId, connectionId, schemaSnapshotHash], references: [tenantId, connectionId, hash], onDelete: Restrict, onUpdate: Restrict, map: "tenant_source_profile_runs_snapshot_fkey")
  profiles   TenantSourceProfile[]

  @@id([tenantId, id])
  @@unique([tenantId, activeKey])
  @@index([tenantId, connectionId, createdAt(sort: Desc)], map: "tenant_source_profile_runs_tenant_id_connection_id_created_idx")
  @@map("tenant_source_profile_runs")
}

/// M9A: one object's profile (aggregates only; immutable). Origin is a profile
/// run or a sync run (run-quality profile).
model TenantSourceProfile {
  tenantId           String   @map("tenant_id") @db.Uuid
  id                 String   @db.Uuid
  runId              String?  @map("run_id") @db.Uuid
  syncRunId          String?  @map("sync_run_id") @db.Uuid
  connectionId       String   @map("connection_id") @db.Uuid
  object             String
  schemaSnapshotHash String   @map("schema_snapshot_hash")
  /// profile | sync
  samplingFamily     String   @map("sampling_family")
  previousProfileId  String?  @map("previous_profile_id") @db.Uuid
  document           Json
  documentVersion    Int      @map("document_version")
  contentHash        String   @map("content_hash")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  run        TenantSourceProfileRun?      @relation(fields: [tenantId, runId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "tenant_source_profiles_tenant_id_run_id_fkey")
  syncRun    TenantSyncCheckpoint?        @relation(fields: [tenantId, syncRunId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "tenant_source_profiles_tenant_id_sync_run_id_fkey")
  connection TenantSourceConnection       @relation(fields: [tenantId, connectionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "tenant_source_profiles_tenant_id_connection_id_fkey")
  snapshot   TenantSourceSchemaSnapshot   @relation(fields: [tenantId, connectionId, schemaSnapshotHash], references: [tenantId, connectionId, hash], onDelete: Restrict, onUpdate: Restrict, map: "tenant_source_profiles_tenant_id_connection_id_snapshot_fkey")
  previous   TenantSourceProfile?         @relation("ProfileBaseline", fields: [tenantId, previousProfileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "tenant_source_profiles_tenant_id_previous_profile_id_fkey")
  next       TenantSourceProfile[]        @relation("ProfileBaseline")
  findings   TenantSourceProfileFinding[]

  @@id([tenantId, id])
  @@unique([tenantId, runId, object])
  @@unique([tenantId, syncRunId, object])
  @@index([tenantId, connectionId, object, samplingFamily, createdAt(sort: Desc)], map: "tenant_source_profiles_baseline_idx")
  @@map("tenant_source_profiles")
}

/// M9A: a finding of a profile (codes, names, counts and ratios; immutable).
model TenantSourceProfileFinding {
  tenantId  String   @map("tenant_id") @db.Uuid
  id        String   @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  code      String
  /// advisory | existing_fail_closed | m9a_fail_closed
  class     String
  /// info | warning | review_required
  severity  String
  object    String
  field     String?
  evidence  Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  profile TenantSourceProfile @relation(fields: [tenantId, profileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "tenant_source_profile_findings_tenant_id_profile_id_fkey")

  @@id([tenantId, id])
  @@index([tenantId, profileId], map: "tenant_source_profile_findings_profile_idx")
  @@index([tenantId, code], map: "tenant_source_profile_findings_code_idx")
  @@map("tenant_source_profile_findings")
}

/// M9A: append-only audit of privileged profile purges (retention, D3).
model TenantSourceProfilePurge {
  tenantId        String   @map("tenant_id") @db.Uuid
  id              String   @db.Uuid
  connectionId    String   @map("connection_id") @db.Uuid
  object          String
  kept            Int
  deletedProfiles Int      @map("deleted_profiles")
  deletedFindings Int      @map("deleted_findings")
  actor           String
  correlationId   String   @map("correlation_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  connection TenantSourceConnection @relation(fields: [tenantId, connectionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "tenant_source_profile_purges_tenant_id_connection_id_fkey")

  @@id([tenantId, id])
  @@map("tenant_source_profile_purges")
}

/// M10A1 (ADR 0026): append-only audit of privileged operations, denials
/// included. Identifiers, codes, counts and hashes only. Hash-chained per
/// tenant: `hash = sha256(prev_hash || canonical payload)`; unique prev_hash
/// makes a fork impossible. No UPDATE; DELETE only by the (disabled) owner purge.
model TenantAuditEvent {
  tenantId       String   @map("tenant_id") @db.Uuid
  id             String   @db.Uuid
  seq            Int
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(3)
  actorKind      String   @map("actor_kind")
  actorId        String   @map("actor_id")
  actorAssurance String   @map("actor_assurance")
  capability     String
  action         String
  /// allowed | denied | failed | completed
  outcome        String
  reasonCode     String?  @map("reason_code")
  targetKind     String?  @map("target_kind")
  targetRef      String?  @map("target_ref")
  correlationId  String   @map("correlation_id") @db.Uuid
  policyVersion  Int      @map("policy_version")
  details        Json     @default("{}")
  prevHash       String   @map("prev_hash")
  hash           String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, id])
  @@unique([tenantId, seq])
  @@unique([tenantId, prevHash])
  @@unique([tenantId, hash])
  @@index([tenantId, occurredAt])
  @@index([tenantId, correlationId])
  @@map("tenant_audit_events")
}

/// M10A1: chain anchors left by an audit purge (the last purged event's seq and
/// hash), so the remaining chain still verifies. Append-only; written only by
/// the owner-path purge, which stays disabled until the retention policy is
/// approved.
model TenantAuditAnchor {
  tenantId      String   @map("tenant_id") @db.Uuid
  id            String   @db.Uuid
  anchorSeq     Int      @map("anchor_seq")
  anchorHash    String   @map("anchor_hash")
  purged        Int
  cutoff        DateTime @db.Timestamptz(3)
  actor         String
  correlationId String   @map("correlation_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, id])
  @@unique([tenantId, anchorSeq])
  @@map("tenant_audit_anchors")
}

// ---------------------------------------------------------------------------
// M10A2 (ADR 0027): canonical versions, adoption, modules, registries
// ---------------------------------------------------------------------------

/// Platform reference table: canonical model versions (MAJOR.MINOR). The
/// app role may only read it; `major >= 1` is refused until the freeze.
model CanonicalModelVersion {
  version       String   @id
  major         Int      @db.SmallInt
  minor         Int      @db.SmallInt
  /// current | supported | deprecated | unsupported
  status        String
  releasedAt    DateTime @map("released_at") @db.Timestamptz(3)
  catalogueHash String   @map("catalogue_hash")
  adr           String

  adoptions         TenantCanonicalAdoption[]    @relation("AdoptionVersion")
  previousAdoptions TenantCanonicalAdoption[]    @relation("AdoptionPreviousVersion")
  modules           CanonicalModule[]
  registryVersions  TenantRegistryVersion[]
  contextChanges    TenantContextChange[]
  mappingVersions   TenantSourceMappingVersion[]
  evidenceLinks     TenantEvidenceLink[]

  @@unique([major, minor])
  @@map("canonical_model_versions")
}

/// Append-only: which canonical version a tenant has adopted (highest seq = current).
model TenantCanonicalAdoption {
  tenantId        String   @map("tenant_id") @db.Uuid
  id              String   @db.Uuid
  seq             Int
  version         String
  previousVersion String?  @map("previous_version")
  /// baseline | new_tenant | operator_adoption | rollback
  reason          String
  adoptedAt       DateTime @default(now()) @map("adopted_at") @db.Timestamptz(3)
  actorKind       String   @map("actor_kind")
  actorId         String   @map("actor_id")
  actorAssurance  String   @map("actor_assurance")
  correlationId   String   @map("correlation_id") @db.Uuid
  /// NULL only for the migration's baseline rows
  auditEventId    String?  @map("audit_event_id") @db.Uuid
  /// Reserved for M10M (no foreign key until that table exists)
  migrationRunId  String?  @map("migration_run_id") @db.Uuid

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versionRef  CanonicalModelVersion  @relation("AdoptionVersion", fields: [version], references: [version], onDelete: Restrict, onUpdate: Restrict)
  previousRef CanonicalModelVersion? @relation("AdoptionPreviousVersion", fields: [previousVersion], references: [version], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, id])
  @@unique([tenantId, seq])
  @@map("tenant_canonical_adoptions")
}

/// Platform reference table: optional canonical modules (all unavailable in M10A2).
model CanonicalModule {
  moduleKey               String   @id @map("module_key")
  title                   String
  available               Boolean  @default(false)
  minimumCanonicalVersion String?  @map("minimum_canonical_version")
  dependsOn               String[] @default([]) @map("depends_on")
  configSchemaVersion     Int      @default(1) @map("config_schema_version")

  minimumVersion CanonicalModelVersion? @relation(fields: [minimumCanonicalVersion], references: [version], onDelete: Restrict, onUpdate: Restrict)
  settings       TenantModuleSetting[]

  @@map("canonical_modules")
}

/// Current module state per tenant; never deleted (disable keeps data).
model TenantModuleSetting {
  tenantId           String   @map("tenant_id") @db.Uuid
  moduleKey          String   @map("module_key")
  enabled            Boolean  @default(false)
  config             Json     @default("{}")
  version            Int
  updatedAt          DateTime @map("updated_at") @db.Timestamptz(3)
  updatedByKind      String   @map("updated_by_kind")
  updatedById        String   @map("updated_by_id")
  updatedByAssurance String   @map("updated_by_assurance")

  tenant Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  module CanonicalModule            @relation(fields: [moduleKey], references: [moduleKey], onDelete: Restrict, onUpdate: Restrict)
  events TenantModuleSettingEvent[]

  @@id([tenantId, moduleKey])
  @@map("tenant_module_settings")
}

/// Append-only history of module changes (one per change, with its audit event).
model TenantModuleSettingEvent {
  tenantId       String   @map("tenant_id") @db.Uuid
  id             String   @db.Uuid
  seq            Int
  moduleKey      String   @map("module_key")
  fromEnabled    Boolean? @map("from_enabled")
  toEnabled      Boolean  @map("to_enabled")
  fromConfigHash String?  @map("from_config_hash")
  toConfigHash   String   @map("to_config_hash")
  baseVersion    Int      @map("base_version")
  actorKind      String   @map("actor_kind")
  actorId        String   @map("actor_id")
  actorAssurance String   @map("actor_assurance")
  reasonCode     String?  @map("reason_code")
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  auditEventId   String   @map("audit_event_id") @db.Uuid

  setting TenantModuleSetting @relation(fields: [tenantId, moduleKey], references: [tenantId, moduleKey], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, id])
  @@unique([tenantId, moduleKey, seq])
  @@map("tenant_module_setting_events")
}

/// Append-only governed registry versions (data_policy, signal_type, ...).
model TenantRegistryVersion {
  tenantId              String   @map("tenant_id") @db.Uuid
  kind                  String
  version               Int
  baseVersion           Int      @map("base_version")
  document              Json
  documentSchemaVersion Int      @map("document_schema_version")
  contentHash           String   @map("content_hash")
  canonicalVersionMin   String   @map("canonical_version_min")
  effectiveFrom         DateTime @map("effective_from") @db.Timestamptz(3)
  publishedAt           DateTime @default(now()) @map("published_at") @db.Timestamptz(3)
  actorKind             String   @map("actor_kind")
  actorId               String   @map("actor_id")
  actorAssurance        String   @map("actor_assurance")
  correlationId         String   @map("correlation_id") @db.Uuid
  auditEventId          String   @map("audit_event_id") @db.Uuid

  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  canonicalVersion  CanonicalModelVersion  @relation(fields: [canonicalVersionMin], references: [version], onDelete: Restrict, onUpdate: Restrict)
  introducedEntries TenantRegistryEntry[]  @relation("RegistryEntryIntroduced")
  changedEntries    TenantRegistryEntry[]  @relation("RegistryEntryLastChanged")
  extensionValues   TenantExtensionValue[]

  @@id([tenantId, kind, version])
  @@map("tenant_registry_versions")
}

/// Projection of current registry entries; keys never disappear (X1).
model TenantRegistryEntry {
  tenantId      String   @map("tenant_id") @db.Uuid
  id            String   @db.Uuid
  kind          String
  key           String
  /// active | retired | promoted
  status        String   @default("active")
  definition    Json
  introducedIn  Int      @map("introduced_in")
  lastChangedIn Int      @map("last_changed_in")
  sensitivity   String?
  categories    String[]
  updatedAt     DateTime @map("updated_at") @db.Timestamptz(3)

  introduced  TenantRegistryVersion @relation("RegistryEntryIntroduced", fields: [tenantId, kind, introducedIn], references: [tenantId, kind, version], onDelete: Restrict, onUpdate: Restrict)
  lastChanged TenantRegistryVersion @relation("RegistryEntryLastChanged", fields: [tenantId, kind, lastChangedIn], references: [tenantId, kind, version], onDelete: Restrict, onUpdate: Restrict)

  /// M10D: the typed extension stores reference definitions by (tenant, kind, id).
  extensionValues     TenantExtensionValue[]
  customRecords       TenantCustomRecord[]
  customRelationships TenantCustomRelationship[]
  /// M10E: account contexts reference their context type by (tenant, kind, id).
  accountContexts     TenantAccountContext[]
  /// M10D hardening #83: the owner row of a custom object references it by (tenant, kind, key).
  customObjectOwners  TenantCustomObjectOwner[]

  @@id([tenantId, id])
  @@unique([tenantId, kind, key])
  @@unique([tenantId, kind, id])
  @@map("tenant_registry_entries")
}

/// Polymorphic reference anchor (D2, F2). Maintained only by triggers owned by
/// lip_entity_indexer; the app role can only read it. Products by key (D3).
model TenantEntityIndex {
  tenantId  String   @map("tenant_id") @db.Uuid
  id        String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// company | person | product | subscription | person_affiliation (M10C) | custom_record (M10D)
  kind      String
  entityId  String?  @map("entity_id") @db.Uuid
  entityKey String?  @map("entity_key")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant               Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  historyById          TenantValueHistory[]       @relation("ValueHistoryEntityId")
  historyByKey         TenantValueHistory[]       @relation("ValueHistoryEntityKey")
  sourceRefsById       TenantSourceReference[]    @relation("SourceReferenceEntityId")
  sourceRefsByKey      TenantSourceReference[]    @relation("SourceReferenceEntityKey")
  evidenceSubjectById  TenantEvidenceLink[]       @relation("EvidenceSubjectId")
  evidenceSubjectByKey TenantEvidenceLink[]       @relation("EvidenceSubjectKey")
  evidenceCitedById    TenantEvidenceLink[]       @relation("EvidenceEntityId")
  evidenceCitedByKey   TenantEvidenceLink[]       @relation("EvidenceEntityKey")
  extTargetById        TenantExtensionValue[]     @relation("ExtensionValueTargetId")
  extTargetByKey       TenantExtensionValue[]     @relation("ExtensionValueTargetKey")
  extRefById           TenantExtensionValue[]     @relation("ExtensionValueRefId")
  extRefByKey          TenantExtensionValue[]     @relation("ExtensionValueRefKey")
  customParentById     TenantCustomRecord[]       @relation("CustomRecordParentId")
  customParentByKey    TenantCustomRecord[]       @relation("CustomRecordParentKey")
  customFromById       TenantCustomRelationship[] @relation("CustomRelationshipFromId")
  customFromByKey      TenantCustomRelationship[] @relation("CustomRelationshipFromKey")
  customToById         TenantCustomRelationship[] @relation("CustomRelationshipToId")
  customToByKey        TenantCustomRelationship[] @relation("CustomRelationshipToKey")

  @@id([tenantId, id])
  @@unique([tenantId, kind, entityId])
  @@unique([tenantId, kind, entityKey])
  @@map("tenant_entity_index")
}

/// Append-only value history of the catalogued fields; value-free for
/// sensitive fields the data policy does not allow.
model TenantValueHistory {
  tenantId       String   @map("tenant_id") @db.Uuid
  id             String   @db.Uuid
  entityKind     String   @map("entity_kind")
  entityId       String?  @map("entity_id") @db.Uuid
  entityKey      String?  @map("entity_key")
  field          String
  valuesRecorded Boolean  @map("values_recorded")
  oldValue       Json?    @map("old_value")
  newValue       Json?    @map("new_value")
  effectiveAt    DateTime @map("effective_at") @db.Timestamptz(3)
  recordedAt     DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)
  changeId       String   @map("change_id") @db.Uuid
  /// canonical_lifecycle | sensitive_value_history
  retentionClass String   @map("retention_class")
  policyVersion  Int?     @map("policy_version")
  actorKind      String   @map("actor_kind")
  actorId        String   @map("actor_id")
  actorAssurance String   @map("actor_assurance")

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  change      TenantContextChange @relation(fields: [tenantId, changeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  byEntityId  TenantEntityIndex?  @relation("ValueHistoryEntityId", fields: [tenantId, entityKind, entityId], references: [tenantId, kind, entityId], onDelete: Restrict, onUpdate: Restrict)
  byEntityKey TenantEntityIndex?  @relation("ValueHistoryEntityKey", fields: [tenantId, entityKind, entityKey], references: [tenantId, kind, entityKey], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, id])
  @@index([tenantId, entityKind, entityId, effectiveAt])
  @@index([tenantId, changeId])
  @@map("tenant_value_history")
}

/// Mutable mapping working copy (draft | validated); one per connection.
model TenantSourceMappingDraft {
  tenantId                  String   @map("tenant_id") @db.Uuid
  connectionId              String   @map("connection_id") @db.Uuid
  id                        String   @db.Uuid
  /// draft | validated
  state                     String   @default("draft")
  document                  Json
  contentHash               String   @map("content_hash")
  version                   Int
  validatedSnapshotHash     String?  @map("validated_snapshot_hash")
  validatedAuthorityVersion Int?     @map("validated_authority_version")
  validatedCanonicalVersion String?  @map("validated_canonical_version")
  validation                Json?
  updatedByKind             String   @map("updated_by_kind")
  updatedById               String   @map("updated_by_id")
  updatedByAssurance        String   @map("updated_by_assurance")
  updatedAt                 DateTime @map("updated_at") @db.Timestamptz(3)

  connection TenantSourceConnection @relation(fields: [tenantId, connectionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, id])
  @@unique([tenantId, connectionId])
  @@map("tenant_source_mapping_drafts")
}

/// Append-only lifecycle of published mapping versions (published | superseded | retired).
model TenantSourceMappingLifecycle {
  tenantId       String   @map("tenant_id") @db.Uuid
  connectionId   String   @map("connection_id") @db.Uuid
  version        Int
  seq            Int
  state          String
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorKind      String   @map("actor_kind")
  actorId        String   @map("actor_id")
  actorAssurance String   @map("actor_assurance")
  reasonCode     String?  @map("reason_code")
  /// NULL only for the migration's backfill
  auditEventId   String?  @map("audit_event_id") @db.Uuid

  mapping TenantSourceMappingVersion @relation(fields: [tenantId, connectionId, version], references: [tenantId, connectionId, version], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, connectionId, version, seq])
  @@map("tenant_source_mapping_lifecycle")
}

/// Append-only record of completed integrity verification runs.
model TenantIntegrityRun {
  tenantId       String   @map("tenant_id") @db.Uuid
  id             String   @db.Uuid
  startedAt      DateTime @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime @map("finished_at") @db.Timestamptz(3)
  /// passed | findings | failed
  outcome        String
  checks         Json
  findings       Json
  actorKind      String   @map("actor_kind")
  actorId        String   @map("actor_id")
  actorAssurance String   @map("actor_assurance")
  correlationId  String   @map("correlation_id") @db.Uuid
  auditEventId   String   @map("audit_event_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, id])
  @@index([tenantId, finishedAt])
  @@map("tenant_integrity_runs")
}

/// M10B (ADR 0028): generic source references for non-legacy entity kinds,
/// anchored in the entity index (products by key, D3). Company / person
/// references stay in their legacy stores (exposed through the
/// source_reference_index view). References change state, never disappear.
model TenantSourceReference {
  tenantId               String    @map("tenant_id") @db.Uuid
  id                     String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  system                 String
  /// recorded, not part of the key (Q10)
  connectionId           String?   @map("connection_id") @db.Uuid
  objectType             String    @map("object_type")
  externalId             String    @map("external_id")
  /// GENERIC_REFERENCE_KINDS (M10B: product); legacy kinds refused by CHECK
  entityKind             String    @map("entity_kind")
  entityId               String?   @map("entity_id") @db.Uuid
  entityKey              String?   @map("entity_key")
  /// observed | declared
  origin                 String
  declaredInModelVersion Int?      @map("declared_in_model_version")
  /// active | retired | deleted | merged
  state                  String    @default("active")
  mergedIntoExternalId   String?   @map("merged_into_external_id")
  firstSeenAt            DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt             DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  sourceCreatedAt        DateTime? @map("source_created_at") @db.Timestamptz(3)
  sourceUpdatedAt        DateTime? @map("source_updated_at") @db.Timestamptz(3)
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(3)
  retiredAt              DateTime? @map("retired_at") @db.Timestamptz(3)
  retiredByRunId         String?   @map("retired_by_run_id") @db.Uuid
  retiredByModelVersion  Int?      @map("retired_by_model_version")
  /// SHA-256 of the last applied observation (idempotency; no values)
  fieldHash              String?   @map("field_hash")
  lastChangeId           String?   @map("last_change_id") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  connector      ConnectorKind           @relation(fields: [system], references: [kind], onDelete: Restrict, onUpdate: Restrict)
  connection     TenantSourceConnection? @relation(fields: [tenantId, connectionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  byEntityId     TenantEntityIndex?      @relation("SourceReferenceEntityId", fields: [tenantId, entityKind, entityId], references: [tenantId, kind, entityId], onDelete: Restrict, onUpdate: Restrict)
  byEntityKey    TenantEntityIndex?      @relation("SourceReferenceEntityKey", fields: [tenantId, entityKind, entityKey], references: [tenantId, kind, entityKey], onDelete: Restrict, onUpdate: Restrict)
  declaredIn     TenantProductModel?     @relation("SourceReferenceDeclaredIn", fields: [tenantId, declaredInModelVersion], references: [tenantId, version], onDelete: Restrict, onUpdate: Restrict)
  retiredByModel TenantProductModel?     @relation("SourceReferenceRetiredByModel", fields: [tenantId, retiredByModelVersion], references: [tenantId, version], onDelete: Restrict, onUpdate: Restrict)
  retiredByRun   TenantSyncCheckpoint?   @relation(fields: [tenantId, retiredByRunId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  lastChange     TenantContextChange?    @relation("SourceReferenceLastChange", fields: [tenantId, lastChangeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, id])
  @@unique([tenantId, system, objectType, externalId])
  @@index([tenantId, entityKind, entityId])
  @@index([tenantId, entityKind, entityKey])
  @@index([tenantId, system, objectType, state])
  @@map("tenant_source_references")
}

/// M10B (ADR 0028): immutable evidence links. One link set = everything one
/// write of one subject cites; re-derivation writes a new set that supersedes
/// the old one. Append-only by privilege and trigger.
model TenantEvidenceLink {
  tenantId            String   @map("tenant_id") @db.Uuid
  id                  String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  linkSetId           String   @map("link_set_id") @db.Uuid
  ordinal             Int      @db.SmallInt
  subjectKind         String   @map("subject_kind")
  subjectId           String?  @map("subject_id") @db.Uuid
  subjectKey          String?  @map("subject_key")
  /// entity | change_record | eligibility_snapshot
  evidenceType        String   @map("evidence_type")
  evidenceKind        String?  @map("evidence_kind")
  evidenceId          String?  @map("evidence_id") @db.Uuid
  evidenceKey         String?  @map("evidence_key")
  evidenceChangeId    String?  @map("evidence_change_id") @db.Uuid
  evidenceSnapshotId  String?  @map("evidence_snapshot_id") @db.Uuid
  /// supports | contradicts | derived_from | context
  role                String
  weight              Decimal? @db.Decimal(5, 4)
  /// source_provided | deterministic | ai_derived | human
  origin              String
  /// {key, version, inputs_hash}; required iff origin is derived
  derivation          Json?
  supersedesLinkSetId String?  @map("supersedes_link_set_id") @db.Uuid
  changeId            String?  @map("change_id") @db.Uuid
  canonicalVersion    String   @map("canonical_version")
  actorKind           String   @map("actor_kind")
  actorId             String   @map("actor_id")
  actorAssurance      String   @map("actor_assurance")
  correlationId       String   @map("correlation_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant           Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subjectById      TenantEntityIndex?         @relation("EvidenceSubjectId", fields: [tenantId, subjectKind, subjectId], references: [tenantId, kind, entityId], onDelete: Restrict, onUpdate: Restrict)
  subjectByKey     TenantEntityIndex?         @relation("EvidenceSubjectKey", fields: [tenantId, subjectKind, subjectKey], references: [tenantId, kind, entityKey], onDelete: Restrict, onUpdate: Restrict)
  evidenceById     TenantEntityIndex?         @relation("EvidenceEntityId", fields: [tenantId, evidenceKind, evidenceId], references: [tenantId, kind, entityId], onDelete: Restrict, onUpdate: Restrict)
  evidenceByKey    TenantEntityIndex?         @relation("EvidenceEntityKey", fields: [tenantId, evidenceKind, evidenceKey], references: [tenantId, kind, entityKey], onDelete: Restrict, onUpdate: Restrict)
  evidenceChange   TenantContextChange?       @relation("EvidenceLinkEvidenceChange", fields: [tenantId, evidenceChangeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  evidenceSnapshot TenantEligibilitySnapshot? @relation(fields: [tenantId, evidenceSnapshotId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  change           TenantContextChange?       @relation("EvidenceLinkChange", fields: [tenantId, changeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  canonical        CanonicalModelVersion      @relation(fields: [canonicalVersion], references: [version], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, id])
  @@unique([tenantId, linkSetId, ordinal])
  @@index([tenantId, subjectKind, subjectId])
  @@index([tenantId, subjectKind, subjectKey])
  @@index([tenantId, evidenceKind, evidenceId])
  @@index([tenantId, evidenceChangeId])
  @@map("tenant_evidence_links")
}

/// M10C (ADR 0029): Person–Account affiliation, one row per period. Tenant-owned,
/// forced RLS; the app role may SELECT/INSERT/UPDATE but never DELETE (affiliations
/// end, never disappear). Endpoints are direct composite FKs (F2) and immutable;
/// "is primary" is derived from persons.company_id, never stored.
model TenantPersonAffiliation {
  tenantId     String    @map("tenant_id") @db.Uuid
  id           String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId     String    @map("person_id") @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  /// active | ended | merged (ended / merged are terminal)
  status       String    @default("active")
  /// identifiers from the mapping's explicit value map only (0–10, ^[a-z0-9_]{1,64}$)
  roleCodes    String[]  @default([]) @map("role_codes")
  /// business period as stated by the source or operator
  startsAt     DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime? @map("ends_at") @db.Timestamptz(3)
  /// when the platform recorded the ending (NULL iff active)
  endedAt      DateTime? @map("ended_at") @db.Timestamptz(3)
  /// source_end_date | source_removed | operator | person_merged | company_merged (NULL iff active)
  endReason    String?   @map("end_reason")
  mergedIntoId String?   @map("merged_into_id") @db.Uuid
  /// source_provided | human
  origin       String
  /// SHA-256 of the last applied fields (idempotency; no values)
  fieldHash    String?   @map("field_hash")
  lastChangeId String?   @map("last_change_id") @db.Uuid
  /// when an operator handed an operator-ended pair back to the source (NULL = the operator's ending stands)
  releasedAt   DateTime? @map("released_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  person     Person                    @relation(fields: [tenantId, personId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  company    Company                   @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  mergedInto TenantPersonAffiliation?  @relation("AffiliationMergedInto", fields: [tenantId, mergedIntoId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  mergedFrom TenantPersonAffiliation[] @relation("AffiliationMergedInto")
  lastChange TenantContextChange?      @relation(fields: [tenantId, lastChangeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, id])
  @@index([tenantId, personId, status])
  @@index([tenantId, companyId, status])
  @@map("tenant_person_affiliations")
}

/// M10D (ADR 0030): typed extension values (option A). One row per (target, field);
/// no row = unknown, value_state 'empty' = explicitly empty. Exactly the value
/// column(s) of value_type are set (CHECK tenant_extension_values_typed).
/// Targets and reference values are anchored in the entity index; the field is a
/// registry entry of kind 'extension'. Tenant-owned, forced RLS; the app role may
/// SELECT/INSERT/UPDATE, never DELETE. Sensitivity is read from the registry entry.
model TenantExtensionValue {
  tenantId           String    @map("tenant_id") @db.Uuid
  id                 String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// company | person | subscription | product | person_affiliation | custom_record
  targetKind         String    @map("target_kind")
  targetId           String?   @map("target_id") @db.Uuid
  /// products only (D3)
  targetKey          String?   @map("target_key")
  /// always 'extension' (CHECK); part of the composite FK proving the entry kind
  fieldRegistryKind  String    @default("extension") @map("field_registry_kind")
  fieldId            String    @map("field_id") @db.Uuid
  /// copied from the definition at write; immutable
  valueType          String    @map("value_type")
  /// present | empty
  valueState         String    @map("value_state")
  valueText          String?   @map("value_text")
  valueNumber        Decimal?  @map("value_number") @db.Decimal
  valueBool          Boolean?  @map("value_bool")
  valueDate          DateTime? @map("value_date") @db.Date
  valueTs            DateTime? @map("value_ts") @db.Timestamptz(3)
  valueMoneyMinor    BigInt?   @map("value_money_minor")
  valueCurrency      String?   @map("value_currency") @db.Char(3)
  valueEnum          String?   @map("value_enum")
  /// multi_enum / array: number of item rows
  valueItemCount     Int?      @map("value_item_count") @db.SmallInt
  valueJson          Json?     @map("value_json")
  valueRefKind       String?   @map("value_ref_kind")
  valueRefId         String?   @map("value_ref_id") @db.Uuid
  valueRefKey        String?   @map("value_ref_key")
  /// source_provided | human | migration
  origin             String
  sourceConnectionId String?   @map("source_connection_id") @db.Uuid
  sourceObjectType   String?   @map("source_object_type")
  sourceRecordId     String?   @map("source_record_id")
  observedAt         DateTime? @map("observed_at") @db.Timestamptz(3)
  sourceUpdatedAt    DateTime? @map("source_updated_at") @db.Timestamptz(3)
  /// SHA-256 of the last applied value (idempotency; no values)
  fieldHash          String?   @map("field_hash")
  /// the extension registry version the value was validated against
  registryVersion    Int       @map("registry_version")
  /// when an operator handed a human value back to the source (Q16)
  releasedAt         DateTime? @map("released_at") @db.Timestamptz(3)
  lastChangeId       String?   @map("last_change_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  targetById  TenantEntityIndex?         @relation("ExtensionValueTargetId", fields: [tenantId, targetKind, targetId], references: [tenantId, kind, entityId], onDelete: Restrict, onUpdate: Restrict, map: "tenant_extension_values_target_id_fkey")
  targetByKey TenantEntityIndex?         @relation("ExtensionValueTargetKey", fields: [tenantId, targetKind, targetKey], references: [tenantId, kind, entityKey], onDelete: Restrict, onUpdate: Restrict, map: "tenant_extension_values_target_key_fkey")
  field       TenantRegistryEntry        @relation(fields: [tenantId, fieldRegistryKind, fieldId], references: [tenantId, kind, id], onDelete: Restrict, onUpdate: Restrict)
  registry    TenantRegistryVersion      @relation(fields: [tenantId, fieldRegistryKind, registryVersion], references: [tenantId, kind, version], onDelete: Restrict, onUpdate: Restrict)
  refById     TenantEntityIndex?         @relation("ExtensionValueRefId", fields: [tenantId, valueRefKind, valueRefId], references: [tenantId, kind, entityId], onDelete: Restrict, onUpdate: Restrict, map: "tenant_extension_values_ref_id_fkey")
  refByKey    TenantEntityIndex?         @relation("ExtensionValueRefKey", fields: [tenantId, valueRefKind, valueRefKey], references: [tenantId, kind, entityKey], onDelete: Restrict, onUpdate: Restrict, map: "tenant_extension_values_ref_key_fkey")
  connection  TenantSourceConnection?    @relation(fields: [tenantId, sourceConnectionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  lastChange  TenantContextChange?       @relation(fields: [tenantId, lastChangeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  items       TenantExtensionValueItem[]

  @@id([tenantId, id])
  @@unique([tenantId, targetKind, targetId, fieldId])
  @@unique([tenantId, targetKind, targetKey, fieldId])
  @@index([tenantId, targetKind, targetId])
  @@index([tenantId, fieldId, valueNumber])
  @@index([tenantId, fieldId, valueBool])
  @@index([tenantId, fieldId, valueDate])
  @@index([tenantId, fieldId, valueTs])
  @@index([tenantId, fieldId, valueCurrency, valueMoneyMinor])
  @@index([tenantId, fieldId, valueEnum])
  @@index([tenantId, fieldId, valueRefKind, valueRefId])
  @@map("tenant_extension_values")
}

/// M10D: items of a multi_enum / array value, replaced on change (Q26: the only
/// M10D table the app role may DELETE from). Exactly one item column by type.
model TenantExtensionValueItem {
  tenantId   String    @map("tenant_id") @db.Uuid
  valueId    String    @map("value_id") @db.Uuid
  ordinal    Int       @db.SmallInt
  /// string | number | integer | date | enum
  itemType   String    @map("item_type")
  itemText   String?   @map("item_text")
  itemNumber Decimal?  @map("item_number") @db.Decimal
  itemDate   DateTime? @map("item_date") @db.Date
  itemEnum   String?   @map("item_enum")

  tenant Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  value  TenantExtensionValue @relation(fields: [tenantId, valueId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, valueId, ordinal])
  @@index([tenantId, itemEnum])
  @@map("tenant_extension_value_items")
}

/// M10D: records of tenant-defined custom objects (entity-index kind custom_record).
/// Platform UUID identity; optional natural-key hash unique per object; optional
/// parent anchored in the entity index. Records change state, never disappear.
model TenantCustomRecord {
  tenantId           String   @map("tenant_id") @db.Uuid
  id                 String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// always 'extension' (CHECK)
  objectRegistryKind String   @default("extension") @map("object_registry_kind")
  objectId           String   @map("object_id") @db.Uuid
  /// company | person | subscription | product (NULL = no parent)
  parentKind         String?  @map("parent_kind")
  parentId           String?  @map("parent_id") @db.Uuid
  parentKey          String?  @map("parent_key")
  naturalKeyHash     String?  @map("natural_key_hash")
  /// active | inactive | retired | merged
  recordState        String   @default("active") @map("record_state")
  mergedIntoId       String?  @map("merged_into_id") @db.Uuid
  /// source_provided | human | migration
  origin             String
  fieldHash          String?  @map("field_hash")
  lastChangeId       String?  @map("last_change_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  object      TenantRegistryEntry  @relation(fields: [tenantId, objectRegistryKind, objectId], references: [tenantId, kind, id], onDelete: Restrict, onUpdate: Restrict)
  parentById  TenantEntityIndex?   @relation("CustomRecordParentId", fields: [tenantId, parentKind, parentId], references: [tenantId, kind, entityId], onDelete: Restrict, onUpdate: Restrict, map: "tenant_custom_records_parent_id_fkey")
  parentByKey TenantEntityIndex?   @relation("CustomRecordParentKey", fields: [tenantId, parentKind, parentKey], references: [tenantId, kind, entityKey], onDelete: Restrict, onUpdate: Restrict, map: "tenant_custom_records_parent_key_fkey")
  mergedInto  TenantCustomRecord?  @relation("CustomRecordMergedInto", fields: [tenantId, mergedIntoId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  mergedFrom  TenantCustomRecord[] @relation("CustomRecordMergedInto")
  lastChange  TenantContextChange? @relation(fields: [tenantId, lastChangeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, id])
  @@unique([tenantId, objectId, naturalKeyHash])
  @@index([tenantId, objectId, recordState])
  @@index([tenantId, parentKind, parentId])
  @@map("tenant_custom_records")
}

/// M10D: edges of tenant-defined custom relationships; both ends in the entity
/// index, at least one a custom record. Cardinality and one active edge per
/// (definition, from, to) are enforced by the writer and a guard trigger (Q27).
/// Edges end, never disappear. Not indexed in the entity index (Q25).
model TenantCustomRelationship {
  tenantId           String    @map("tenant_id") @db.Uuid
  id                 String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// always 'extension' (CHECK)
  relRegistryKind    String    @default("extension") @map("rel_registry_kind")
  relDefId           String    @map("rel_def_id") @db.Uuid
  fromKind           String    @map("from_kind")
  fromId             String?   @map("from_id") @db.Uuid
  fromKey            String?   @map("from_key")
  toKind             String    @map("to_kind")
  toId               String?   @map("to_id") @db.Uuid
  toKey              String?   @map("to_key")
  roleCode           String?   @map("role_code")
  /// active | ended
  state              String    @default("active")
  endedAt            DateTime? @map("ended_at") @db.Timestamptz(3)
  /// source_removed | operator | endpoint_merged
  endReason          String?   @map("end_reason")
  /// source_provided | human | migration
  origin             String
  sourceConnectionId String?   @map("source_connection_id") @db.Uuid
  sourceObjectType   String?   @map("source_object_type")
  sourceRecordId     String?   @map("source_record_id")
  lastChangeId       String?   @map("last_change_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  definition TenantRegistryEntry     @relation(fields: [tenantId, relRegistryKind, relDefId], references: [tenantId, kind, id], onDelete: Restrict, onUpdate: Restrict)
  fromById   TenantEntityIndex?      @relation("CustomRelationshipFromId", fields: [tenantId, fromKind, fromId], references: [tenantId, kind, entityId], onDelete: Restrict, onUpdate: Restrict, map: "tenant_custom_relationships_from_id_fkey")
  fromByKey  TenantEntityIndex?      @relation("CustomRelationshipFromKey", fields: [tenantId, fromKind, fromKey], references: [tenantId, kind, entityKey], onDelete: Restrict, onUpdate: Restrict, map: "tenant_custom_relationships_from_key_fkey")
  toById     TenantEntityIndex?      @relation("CustomRelationshipToId", fields: [tenantId, toKind, toId], references: [tenantId, kind, entityId], onDelete: Restrict, onUpdate: Restrict, map: "tenant_custom_relationships_to_id_fkey")
  toByKey    TenantEntityIndex?      @relation("CustomRelationshipToKey", fields: [tenantId, toKind, toKey], references: [tenantId, kind, entityKey], onDelete: Restrict, onUpdate: Restrict, map: "tenant_custom_relationships_to_key_fkey")
  connection TenantSourceConnection? @relation(fields: [tenantId, sourceConnectionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  lastChange TenantContextChange?    @relation(fields: [tenantId, lastChangeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, id])
  @@index([tenantId, relDefId, fromKind, fromId, state])
  @@index([tenantId, relDefId, toKind, toId, state])
  @@map("tenant_custom_relationships")
}

/// M10E (ADR 0031): account contexts — a scoped view of one account (for example
/// a product in a region) typed by a tenant-published `context_type` registry entry.
/// Direct composite FK to the account (F2). Natural key (company, type, SHA-256 of
/// the ordered dimension values) unique among active rows, enforced by the guard
/// trigger (a partial unique index cannot be expressed in this schema without drift).
/// Contexts change status or merge, never disappear (no DELETE grant).
model TenantAccountContext {
  tenantId                String    @map("tenant_id") @db.Uuid
  id                      String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId               String    @map("company_id") @db.Uuid
  /// always 'context_type' (CHECK); part of the composite FK proving the entry kind
  contextTypeRegistryKind String    @default("context_type") @map("context_type_registry_kind")
  contextTypeId           String    @map("context_type_id") @db.Uuid
  /// SHA-256 of the canonical JSON of the ordered dimension values (Q4)
  naturalKeyHash          String    @map("natural_key_hash")
  /// flat object of <= 6 scalar values, classified per row by the context type
  dimensions              Json      @default("{}")
  name                    String
  /// active | inactive | retired
  status                  String    @default("active")
  /// opaque source owner id (Q12; never an email, never a person FK)
  ownerRef                String?   @map("owner_ref")
  renewalDate             DateTime? @map("renewal_date") @db.Date
  /// active | merged (see merged_into_id)
  recordState             String    @default("active") @map("record_state")
  mergedIntoId            String?   @map("merged_into_id") @db.Uuid
  lastChangeId            String?   @map("last_change_id") @db.Uuid
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  company       Company                       @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  contextType   TenantRegistryEntry           @relation(fields: [tenantId, contextTypeRegistryKind, contextTypeId], references: [tenantId, kind, id], onDelete: Restrict, onUpdate: Restrict)
  mergedInto    TenantAccountContext?         @relation("AccountContextMergedInto", fields: [tenantId, mergedIntoId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  mergedFrom    TenantAccountContext[]        @relation("AccountContextMergedInto")
  lastChange    TenantContextChange?          @relation(fields: [tenantId, lastChangeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  persons       TenantAccountContextPerson[]
  products      TenantAccountContextProduct[]
  subscriptions TenantSubscription[]

  @@id([tenantId, id])
  @@index([tenantId, companyId])
  @@index([tenantId, contextTypeId])
  @@index([tenantId, companyId, contextTypeId, naturalKeyHash])
  @@map("tenant_account_contexts")
}

/// M10E: persons of an account context with a type-declared role code. Ended,
/// never deleted (Q10); an affiliation with the context's account is not required (Q9).
model TenantAccountContextPerson {
  tenantId     String    @map("tenant_id") @db.Uuid
  contextId    String    @map("context_id") @db.Uuid
  personId     String    @map("person_id") @db.Uuid
  roleCode     String    @map("role_code")
  /// active | ended
  status       String    @default("active")
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt      DateTime? @map("ended_at") @db.Timestamptz(3)
  lastChangeId String?   @map("last_change_id") @db.Uuid

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  context    TenantAccountContext @relation(fields: [tenantId, contextId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  person     Person               @relation(fields: [tenantId, personId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  lastChange TenantContextChange? @relation(fields: [tenantId, lastChangeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, contextId, personId, roleCode])
  @@index([tenantId, personId])
  @@map("tenant_account_context_persons")
}

/// M10E: products of an account context — from product dimensions or explicit
/// (when the type allows, Q7). Kept for history after a product key retires.
model TenantAccountContextProduct {
  tenantId   String   @map("tenant_id") @db.Uuid
  contextId  String   @map("context_id") @db.Uuid
  productKey String   @map("product_key")
  /// dimension | explicit
  origin     String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  context TenantAccountContext @relation(fields: [tenantId, contextId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  product TenantProduct        @relation(fields: [tenantId, productKey], references: [tenantId, key], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, contextId, productKey])
  @@index([tenantId, productKey])
  @@map("tenant_account_context_products")
}

/// M10D hardening #83 (ADR 0030 addendum, Q14): the single owner connection of
/// each custom object, one row per (tenant, object key) — the primary key makes
/// a second concurrent owner a unique violation. Claimed and released in the
/// mapping publish / retire transaction; released = connection NULL (no DELETE).
model TenantCustomObjectOwner {
  tenantId       String    @map("tenant_id") @db.Uuid
  /// the custom object's registry key (kind extension)
  objectKey      String    @map("object_key")
  /// always 'extension' (CHECK); part of the composite FK proving the registry entry
  registryKind   String    @default("extension") @map("registry_kind")
  /// the owning connection; NULL = released (no owner)
  connectionId   String?   @map("connection_id") @db.Uuid
  /// the owner's published mapping version holding the claim (NULL when released)
  mappingVersion Int?      @map("mapping_version")
  claimedAt      DateTime? @map("claimed_at") @db.Timestamptz(3)
  releasedAt     DateTime? @map("released_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  object     TenantRegistryEntry         @relation(fields: [tenantId, registryKind, objectKey], references: [tenantId, kind, key], onDelete: Restrict, onUpdate: Restrict)
  connection TenantSourceConnection?     @relation(fields: [tenantId, connectionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  mapping    TenantSourceMappingVersion? @relation(fields: [tenantId, connectionId, mappingVersion], references: [tenantId, connectionId, version], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, objectKey])
  @@index([tenantId, connectionId, mappingVersion])
  @@map("tenant_custom_object_owners")
}

/// M10E hardening #90 (ADR 0031 addendum): an explicit, tenant-scoped grant of a
/// capability no actor kind holds by policy (only
/// data.account_context.read_confidential) to one operator id. Revoked by clearing
/// `active`, re-granted by setting it again; never deleted. No self-grant.
model TenantCapabilityGrant {
  tenantId           String    @map("tenant_id") @db.Uuid
  /// operator
  actorKind          String    @map("actor_kind")
  actorId            String    @map("actor_id")
  capability         String
  active             Boolean
  version            Int
  grantedAt          DateTime  @map("granted_at") @db.Timestamptz(3)
  grantedByKind      String    @map("granted_by_kind")
  grantedById        String    @map("granted_by_id")
  grantedByAssurance String    @map("granted_by_assurance")
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedByKind      String?   @map("revoked_by_kind")
  revokedById        String?   @map("revoked_by_id")
  revokedByAssurance String?   @map("revoked_by_assurance")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, actorKind, actorId, capability])
