{
  "name": "@lip/api",
  "version": "0.0.0",
  "private": true,
  "description": "Modular-monolith backend: HTTP API process and background worker process",
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --config vitest.config.mts",
    "test:integration": "prisma generate && vitest run --config vitest.integration.config.mts",
    "depcheck:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "test:coverage": "vitest run --config vitest.config.mts --coverage",
    "tenant:provision": "node dist/cli/provision-tenant.js",
    "hubspot:configure": "node dist/cli/hubspot-configure.js",
    "hubspot:discover": "node dist/cli/hubspot-discovery.js",
    "hubspot:install-url": "node dist/cli/hubspot-install-url.js",
    "hubspot:webhook-report": "node dist/cli/hubspot-webhook-report.js",
    "hubspot:oauth-refresh-evidence": "node dist/cli/hubspot-oauth-refresh-evidence.js",
    "test:live": "vitest run --config vitest.live.config.mts"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation-express": "^0.70.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-ioredis": "^0.70.0",
    "@opentelemetry/instrumentation-nestjs-core": "^0.68.0",
    "@opentelemetry/instrumentation-pg": "^0.74.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/nestjs": "^11.0.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.2.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.7",
    "@nestjs/schematics": "^12.0.5",
    "@nestjs/testing": "^12.1.0",
    "@swc/core": "^1.16.2",
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/redis": "^12.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.2",
    "dependency-cruiser": "^18.4.0",
    "dotenv": "^18.0.4",
    "prisma": "7.10.0",
    "supertest": "^7.3.0",
    "testcontainers": "^12.1.0",
    "typescript": "6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.2"
  }
}
