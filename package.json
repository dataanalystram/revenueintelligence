{
  "name": "lead-intelligence-platform",
  "private": true,
  "description": "Juniper / Wigmore Lead Intelligence Platform — HubSpot, Sugar CRM and Gainsight lead handover and qualification",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm --filter @lip/api prisma:generate && eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm -r test:integration",
    "depcheck:boundaries": "pnpm -r depcheck:boundaries",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm depcheck:boundaries && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
