# ---------------------------------------------------------------------------
# Lead Intelligence Platform — environment template
#
#   cp .env.example apps/api/.env      (the .env file is git-ignored)
#
# NEVER commit real credentials. In deployed environments, inject these from
# your secret manager / platform settings instead of a file.
# ---------------------------------------------------------------------------

# --- Process ---------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info            # fatal | error | warn | info | debug | trace | silent

# --- Infrastructure (matches docker-compose.yml) ----------------------------
# The application connects as a NON-privileged member of the lip_app role so
# PostgreSQL row-level security isolates tenants (ADR 0008). It refuses to
# start as a superuser or BYPASSRLS role.
DATABASE_URL=postgresql://lip_api:lip_api@localhost:5432/lip
# Migrations run as the schema owner (used only by `prisma migrate`).
MIGRATION_DATABASE_URL=postgresql://lip:lip@localhost:5432/lip
DATABASE_POOL_MAX=10
DATABASE_TRANSACTION_TIMEOUT_MS=15000
# Longest wait for a lock (e.g. per-tenant configuration lock) before a retryable error.
DATABASE_LOCK_TIMEOUT_MS=5000
# Development escape hatch only; rejected when NODE_ENV=production.
DATABASE_ALLOW_PRIVILEGED_ROLE=false
REDIS_URL=redis://localhost:6379

# --- Secrets -----------------------------------------------------------------
# "env" resolves secrets from environment variables (see below). Vault-backed
# providers (Azure Key Vault / AWS Secrets Manager) plug in behind the same
# interface when the hosting target is confirmed.
SECRETS_PROVIDER=env

# --- Observability (optional; both disabled when unset) ---------------------
OTEL_ENABLED=false
# OTEL_SERVICE_NAME=lead-intelligence-platform
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Integration credentials — NOT needed until Milestone 3.
# Read via the SecretProvider using logical keys; the env provider maps
# `hubspot.app.client_secret` -> HUBSPOT_APP_CLIENT_SECRET.
#
# Platform-wide (the Wigmore HubSpot app itself): HUBSPOT_APP_*
# Per tenant: TENANT_<SLUG>_<SYSTEM>_<NAME>, e.g. for tenant `juniper`
#   TENANT_JUNIPER_SUGAR_PASSWORD, TENANT_JUNIPER_GAINSIGHT_CS_ACCESS_KEY
# A tenant credential is only resolvable after it is registered for that
# tenant (TenantCredentialsService.register). See docs/credentials.md.
# ---------------------------------------------------------------------------
# HubSpot developer project app (Milestone 3)
# HUBSPOT_APP_ID=
# HUBSPOT_APP_CLIENT_ID=
# HUBSPOT_APP_CLIENT_SECRET=
# HUBSPOT_APP_REDIRECT_URI=http://localhost:3000/oauth/hubspot/callback
# HUBSPOT_TEST_ACCOUNT_ID=

# Gainsight CS for tenant `juniper` (Milestone 10). The base URL is non-secret
# tenant configuration (integration settings), not an environment variable.
# TENANT_JUNIPER_GAINSIGHT_CS_ACCESS_KEY=

# Sugar CRM for tenant `juniper` (Milestone 17 — real instance only; M7 uses the mock).
# Base URL, API version and platform are tenant integration settings.
# TENANT_JUNIPER_SUGAR_CLIENT_ID=
# TENANT_JUNIPER_SUGAR_CLIENT_SECRET=
# TENANT_JUNIPER_SUGAR_USERNAME=
# TENANT_JUNIPER_SUGAR_PASSWORD=
